# Nginx configuration for PULS AI Dashboard (HTTPS + Reverse Proxy to Node.js / Express)
# Place this file at /etc/nginx/sites-available/puls-dashboard
# Replace `your-domain.com` with your actual domain name.

server {
    listen 80;
    listen [::]:80;
    server_name your-domain.com; # Замініть на ваш домен або поддомен (наприклад, puls.example.com)

    # Automatic HTTP to HTTPS redirect (Certbot will update this automatically)
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 50M;
    }
}
