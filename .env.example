# ===================================================================
# PULS Dashboard Operational Modes Environment Configuration
# ===================================================================

# MODE 1: AI Studio / Shared Cloud Run (playit.gg tunnel or remote DB)
# MODE 2: Local Docker Desktop (Direct localhost / host.docker.internal)

DB_USER=ai_readonly
DB_PASSWORD=
DB_HOST=della-proportions.tun.ply.gg
DB_PORT=37079
DB_NAME=PULS_COPY
DB_SSL=false

# Cache TTL in seconds for sub-millisecond dashboard calculations
CACHE_TTL_SECONDS=120

# Rate Limiter Configuration (requests per minute per IP)
RATE_LIMIT_WINDOW_MINUTES=1
RATE_LIMIT_MAX=3000

# Security Token for /api/db-config updates (optional, protects remote configuration changes)
ADMIN_CONFIG_TOKEN=
